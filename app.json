{
  "expo": {
    "name": "Jouleops",
    "slug": "smart-ops",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/jouleops-icon.png",
    "scheme": "jouleops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartjoules.jouleops",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/jouleops-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.smartjoules.jouleops",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "./plugins/withGoogleSigninModularHeaders",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E11111",
          "image": "./assets/images/jouleops-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#E11111",
            "image": "./assets/images/jouleops-splash.png"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jouleops needs your location to log attendance at your work site."
        }
      ],
      "expo-task-manager",
      "expo-background-task",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Jouleops needs camera access to scan QR codes on assets."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Jouleops needs camera access to take your profile picture and attach photos to logs.",
          "photosPermission": "Jouleops needs photo library access to set your profile picture and attach photos to logs."
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1868472-0103-49d5-978e-ece327af4c3e"
      }
    },
    "owner": "smartjoules-ops",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1868472-0103-49d5-978e-ece327af4c3e",
      "fallbackToCacheTimeout": 10000
    }
  }
}
